# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# NOTE: the committed env template lives at `env.example` (repo root) — that
# name intentionally does not match this pattern. Copy it to `.env.local`.
.env*

# vercel
.vercel

# Claude Code — personal overrides only; committed config lives in .claude/settings.json
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
